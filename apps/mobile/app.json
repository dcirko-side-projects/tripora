{
  "expo": {
    "name": "Tripora",
    "slug": "tripora",
    "version": "0.1.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "platforms": [
      "android",
      "ios",
      "web"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0593C6"
      }
    },
    "plugins": [
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Dopusti Tripori odabir fotografija za naslovnice i uspomene s putovanja.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "@maplibre/maplibre-react-native",
      ["expo-location", {
        "locationWhenInUsePermission": "Dopusti Tripori prikaz tvoje lokacije na otvorenoj karti.",
        "locationAlwaysPermission": false,
        "locationAlwaysAndWhenInUsePermission": false
      }]
    ],
    "web": {
      "bundler": "metro",
      "output": "single"
    }
  }
}
