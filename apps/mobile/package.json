{
  "name": "tripora-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "branding": "node scripts/generate-branding.cjs",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.tests.json && node --experimental-sqlite --test tests/*.test.cjs",
    "export:android": "expo export --platform android",
    "export:ios": "expo export --platform ios"
  },
  "dependencies": {
    "@maplibre/maplibre-react-native": "11.5.1",
    "@react-native-community/datetimepicker": "9.1.0",
    "expo": "~57.0.31",
    "expo-crypto": "~57.0.4",
    "expo-file-system": "~57.0.7",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-secure-store": "~57.0.0",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@types/react": "~19.2.2",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "node-forge": "1.4.2",
    "@expo/cli": {
      "zod": "4.6.6"
    }
  }
}
