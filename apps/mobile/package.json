{
  "name": "tripora-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.tests.json && node --experimental-sqlite --test tests/*.test.cjs",
    "export:android": "expo export --platform android",
    "export:ios": "expo export --platform ios"
  },
  "dependencies": {
    "expo": "~57.0.25",
    "expo-crypto": "~57.0.0",
    "expo-secure-store": "~57.0.0",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  }
}
