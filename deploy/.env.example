# Documentation template only. Set secrets in the hosting dashboard, never in mobile config or Git.
Tripora__EnableHostedBeta=true
Tripora__RequireConfirmedEmail=true
Tripora__DatabaseKeys=true
Tripora__PublicUrl=https://YOUR-SERVICE.onrender.com
Tripora__DatabaseProvider=Neon
ConnectionStrings__Tripora=Host=YOUR-ENDPOINT.neon.tech;Port=5432;Database=neondb;Username=YOUR-USER;Password=SET-IN-DASHBOARD;SSL Mode=VerifyFull;Timeout=30
Tripora__Storage__Mode=Cloudinary
Tripora__Storage__CloudName=YOUR-CLOUD-NAME
Tripora__Storage__ApiKey=SET-SERVER-ONLY
Tripora__Storage__ApiSecret=SET-SERVER-ONLY
Tripora__Email__Mode=Brevo
Tripora__Email__From=YOUR-VERIFIED-SENDER
Tripora__Email__ApiKey=SET-IN-DASHBOARD
Tripora__KeyCertificate=SET-BASE64-PFX-IN-DASHBOARD
Tripora__KeyCertificatePassword=SET-IN-DASHBOARD
# One application-wide upstream lookup at a time; no autocomplete or bulk geocoding.
Tripora__Maps__DailySearchLimit=200
Tripora__Maps__SearchUrl=https://nominatim.openstreetmap.org/search
Tripora__Maps__TileUrl=https://tile.openstreetmap.org/{z}/{x}/{y}.png
Tripora__Maps__Attribution=© OpenStreetMap contributors
Tripora__Maps__AttributionUrl=https://www.openstreetmap.org/copyright
